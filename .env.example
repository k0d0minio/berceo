# Names only — every value lives in Vercel, in GitHub Actions secrets or in a local .env.local
# that git never sees. `.icm/scripts/env.sh audit` reads this file; the note above each key and
# its [targets] suffix are the contract.

# The Neon Postgres connection string. Vercel injects each environment's own from the Storage integration (preview branches get their Neon branch's); locally a branch's string, never production's; the ci copy is production's, read by db-migrate.yml.  [production,preview,development,ci]
DATABASE_URL=

# A Neon API key for the Kodominio org: neon-cleanup.yaml deletes a PR's preview/* and run/* branches with it; db-branch.sh and db-env.sh read it from the shell. Never set in Vercel.  [ci]
NEON_API_KEY=

# Neon Auth (accounts, D-13). The auth URL of the Neon branch this environment's
# database lives on (the Vercel-Neon integration injects it on Vercel; locally, the branch's own).  [production,preview]
NEON_AUTH_BASE_URL=
# Signs the Neon Auth session cache cookie, 32+ characters: openssl rand -base64 32  [production,preview,development]
NEON_AUTH_COOKIE_SECRET=

# Transactional e-mail (Resend): the API key the webhook route sends with.  [production,preview,development]
RESEND_API_KEY=
# The sender is the operator's (D-28): an address on a domain verified on Resend with SPF and
# DKIM at Infomaniak.  [production,preview,development]
EMAIL_FROM=

# Document storage (onboarding-professionnelle): Neon Object Storage, S3-compatible, one private
# bucket per Neon project. UAT and Preview use the non-production project's `main` branch store,
# Production its own project's. Named DOCUMENTS_S3_* because Vercel reserves the AWS_* names.
# The branch's S3 endpoint, e.g. https://br-….storage.c-N.eu-central-1.aws.neon.tech  [production,preview]
DOCUMENTS_S3_ENDPOINT=
# The store's region: eu-central-1.  [production,preview]
DOCUMENTS_S3_REGION=
# The bucket's name: documents.  [production,preview]
DOCUMENTS_BUCKET=
# A Neon credential with storage:read and storage:write, anchored on the store's branch: its token_id.  [production,preview]
DOCUMENTS_S3_ACCESS_KEY_ID=
# The same credential's s3_secret_access_key, shown once at creation.  [production,preview]
DOCUMENTS_S3_SECRET_ACCESS_KEY=

# The daily digest of new requests (demande-de-garde, D-52): the bearer token /api/cron/demandes-digest requires, one value per environment: openssl rand -base64 32. GitHub Actions holds the same values as CRON_SECRET_UAT and CRON_SECRET_PRODUCTION for demandes-digest.yml. Unset, the route refuses every call.  [production,preview]
CRON_SECRET=
