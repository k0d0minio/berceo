# Names only — every value lives in Vercel, in GitHub Actions secrets or in a local .env.local
# that git never sees. The note above each key and its [targets] suffix are the contract.

# The Neon Postgres connection string. Vercel injects each environment's own from the Storage integration (preview branches get their Neon branch's); locally a branch's string, never production's; the ci copy is production's direct string, read by promote.yml's migration only.  [production,preview,development,ci]
DATABASE_URL=

# A Neon API key for the Kodominio org: neon-cleanup.yml deletes a pull request's preview/* branch in the UAT project with it. Never set in Vercel.  [ci,shell]
NEON_API_KEY=
# The direct (unpooled) string of the same branch as DATABASE_URL, set by the Neon integration, for the migrations at build.  [production,preview]
DATABASE_URL_UNPOOLED=

# Read by .icm/scripts/*.sh and the workflows, never by the application (.icm/uat/CONTEXT.md). VERCEL_TOKEN is an
# Actions secret. VERCEL_TEAM (kodominio) and NEON_PROJECT_ID (the UAT project uat-berceo, dawn-scene-70949411) are
# Actions variables. VERCEL_PROJECT stays unset: the Vercel project is named as the repository.  [ci,shell]
VERCEL_TOKEN=
VERCEL_TEAM=
VERCEL_PROJECT=
NEON_PROJECT_ID=

# Neon Auth (accounts, D-13). The auth URL of the Neon branch this environment's
# database lives on (the Vercel-Neon integration injects it on Vercel; locally, the branch's own).  [production,preview]
NEON_AUTH_BASE_URL=
# Signs the Neon Auth session cache cookie, 32+ characters: openssl rand -base64 32  [production,preview,development]
NEON_AUTH_COOKIE_SECRET=

# Transactional e-mail (Resend): the API key the webhook route sends with.  [production,preview,development]
RESEND_API_KEY=
# The sender is the operator's (D-28): an address on a domain verified on Resend with SPF and
# DKIM at Infomaniak.  [production,preview,development]
EMAIL_FROM=

# Document storage (onboarding-professionnelle): Neon Object Storage, S3-compatible, one private
# bucket per Neon project. UAT and Preview use the non-production project's `main` branch store,
# Production its own project's. Named DOCUMENTS_S3_* because Vercel reserves the AWS_* names.
# The branch's S3 endpoint, e.g. https://br-….storage.c-N.eu-central-1.aws.neon.tech  [production,preview]
DOCUMENTS_S3_ENDPOINT=
# The store's region: eu-central-1.  [production,preview]
DOCUMENTS_S3_REGION=
# The bucket's name: documents.  [production,preview]
DOCUMENTS_BUCKET=
# A Neon credential with storage:read and storage:write, anchored on the store's branch: its token_id.  [production,preview]
DOCUMENTS_S3_ACCESS_KEY_ID=
# The same credential's s3_secret_access_key, shown once at creation.  [production,preview]
DOCUMENTS_S3_SECRET_ACCESS_KEY=

# The scheduled jobs' bearer token, one value for every environment (D-68), 16+ characters:
# openssl rand -base64 32. The daily purge of refused files (verification-back-office, D-55):
# Vercel's cron sends it as `Authorization: Bearer <CRON_SECRET>` to /api/cron/purge-dossiers-refuses,
# which answers 404 without it; cron runs on Production only, on UAT and previews the route is
# called by hand. The daily digest of new requests (demande-de-garde, D-62): /api/cron/demandes-digest
# answers 401 without it; .github/workflows/demandes-digest.yml calls it on UAT and production with
# the same value held as the GitHub Actions secret CRON_SECRET.  [production,preview]
CRON_SECRET=

# The service fee (frais-de-service, D-100): Stripe Checkout for the 3 % fee, Bancontact and cards.
# The secret key of the Stripe account: a TEST key (sk_test_…) on Preview (UAT and the PR previews),
# a LIVE key (sk_live_…) on Production once the company's account exists. Not on Vercel's Development
# (operator, 2026-09-25): a local .env.local takes a sandbox key by hand when payments are needed.
# Without it « Confirmer et régler les frais de service » fails with the generic error.  [production,preview]
STRIPE_SECRET_KEY=
# The signing secret (whsec_…) of this environment's webhook endpoint, registered in Stripe's dashboard
# at https://<host>/api/webhooks/stripe for checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, refund.created, refund.updated and refund.failed, and for the
# subscriptions customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid and invoice.payment_failed. One endpoint per
# environment: UAT's (test mode) on Preview, www's (live mode) on Production. PR previews cannot be
# reached by Stripe (Vercel protection); their return page books instead.  [production,preview]
STRIPE_WEBHOOK_SECRET=

# The family subscriptions (abonnements-catalogue-stripe): the Stripe price id (price_…) of each
# of the four plans, one recurring price in euros each, made in the same Stripe account as
# STRIPE_SECRET_KEY: test prices on Preview, live prices on Production. Without one, that plan's
# « Choisir » fails with the generic error.  [production,preview]
STRIPE_PRICE_DECOUVERTE=
STRIPE_PRICE_PARENTHESE=
STRIPE_PRICE_SERENITE=
STRIPE_PRICE_PREMIUM=
